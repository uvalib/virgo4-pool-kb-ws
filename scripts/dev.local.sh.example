#!/usr/bin/env bash
# Local virgo4-pool-kb-ws dev server
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

export JWT_KEY="${JWT_KEY:-${V4_JWT_KEY}}"
export V4_POOL_KB_PORT="${V4_POOL_KB_PORT:-8087}"
export AWS_REGION="${AWS_REGION:-us-east-1}"
export AWS_KB_ID="${AWS_KB_ID}"
export AWS_KB_PROVIDER="${AWS_KB_PROVIDER:-bedrock}"
#export AWS_KB_PROVIDER="${AWS_KB_PROVIDER:-mock}"
export AWS_KB_SCORE_THRESHOLD="${AWS_KB_SCORE_THRESHOLD:-0}"
export AWS_KB_DEFAULT_LIMIT="${AWS_KB_DEFAULT_LIMIT:-20}"
export IIIF_BASE_URL="${IIIF_BASE_URL:-https://iiif.lib.virginia.edu/iiif}"
export VIRGO_DETAIL_SOURCE="${VIRGO_DETAIL_SOURCE:-}"

if [[ ! -x bin/v4poolkb ]]; then
  go build -o bin/v4poolkb ./cmd
fi

ARGS=(
  -port "${V4_POOL_KB_PORT}"
  -jwtkey "${JWT_KEY}"
  -region "${AWS_REGION}"
  -kbid "${AWS_KB_ID}"
  -threshold "${AWS_KB_SCORE_THRESHOLD}"
  -limit "${AWS_KB_DEFAULT_LIMIT}"
  -provider "${AWS_KB_PROVIDER}"
  -iiifbase "${IIIF_BASE_URL}"
  -detailresource "${VIRGO_DETAIL_SOURCE}"
)

exec ./bin/v4poolkb "${ARGS[@]}"
